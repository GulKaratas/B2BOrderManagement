@startuml b2b-state
title Sipariş Durum Makinesi (UML State Diagram)
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Segoe UI
skinparam stateBackgroundColor #ffffff
skinparam stateBorderColor #1e3a5f
skinparam arrowColor #1e3a5f

[*] --> Draft : Portal siparişi
[*] --> Submitted : Entegrasyon siparişi

Draft --> Submitted : Gönder
Draft --> Cancelled : İptal

Submitted --> Confirmed : Onayla\n/ stok düş
Submitted --> Rejected : Reddet
Submitted --> Cancelled : İptal

Confirmed --> Shipped : Sevk et
Confirmed --> Cancelled : İptal\n/ stok iade

Rejected --> [*]
Shipped --> [*]
Cancelled --> [*]
@enduml
